# MPP Business Hub — PROTOTYPE configuration (all values are safe defaults).
# No production secrets belong here. The prototype never reads this file for credentials.

# Always a demo-* project id. Never put a production Firebase project id here.
VITE_FIREBASE_PROJECT_ID=demo-mpp-hub

# AI adapter: "replay" (pre-authored sample findings, free) or "live" (DISABLED in the prototype).
VITE_AI_ADAPTER=replay

# Live model calls are disabled by default and unused by the prototype.
VITE_LIVE_AI_ENABLED=false
