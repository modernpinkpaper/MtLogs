# MPP Business Hub web configuration. Copy this file to .env.local and fill in
# the Firebase web-app values. .env.local is ignored by Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mpp-business-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mpp-business-hub
VITE_FIREBASE_STORAGE_BUCKET=mpp-business-hub.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=124451131603
VITE_FIREBASE_APP_ID=1:124451131603:web:dd8a1c0ee4d5e973cf4426

# AI adapter: "replay" (pre-authored sample findings, free) or "live" (DISABLED in the prototype).
VITE_AI_ADAPTER=replay

# Live model calls are disabled by default and unused by the prototype.
VITE_LIVE_AI_ENABLED=false
